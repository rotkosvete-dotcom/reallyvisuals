name: Build ReallyVisuals Launcher

on:
  workflow_dispatch:
  push:
    tags:
      - "v*"

permissions:
  contents: write

jobs:
  build:
    runs-on: windows-latest
    steps:
      - name: Get source
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install build dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pyinstaller minecraft-launcher-lib

      - name: Build Windows executable
        run: |
          pyinstaller --noconfirm --clean --onefile --windowed --name ReallyVisualsLauncher --collect-all minecraft_launcher_lib --add-data "reallyvisuals-1.0.0.jar;." ReallyVisualsLauncher.py

      - name: Upload EXE artifact
        uses: actions/upload-artifact@v4
        with:
          name: ReallyVisualsLauncher-Windows
          path: dist/ReallyVisualsLauncher.exe
          if-no-files-found: error

      - name: Publish GitHub Release (tag builds only)
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: dist/ReallyVisualsLauncher.exe
